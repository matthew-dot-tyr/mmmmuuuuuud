# --- обязательные ---
SUPABASE_URL=
SUPABASE_KEY=
OPENROUTER_API_KEY=

# JWT-секрет для проверки токенов Supabase Auth (magic link, см. auth.py).
# Взять в дашборде: Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# --- модель (читает ai/llm.py) ---
# qwen3.8-flash быстрая и дешёвая. Если ответы плоские или модель путает
# методики — qwen/qwen3.8-27b-20260814 крупнее и точнее, но медленнее.
QWEN_MODEL=qwen/qwen3.8-flash-20260826
# Потолок длины ответа модели, значения по умолчанию в ai/dialogue.py
# QWEN_START_MAX_TOKENS=700
# QWEN_TURN_MAX_TOKENS=600
# Нужен только при выходе в интернет через VPN/прокси-клиент
# OPENROUTER_PROXY=http://127.0.0.1:10809
OPENROUTER_PROXY=

# --- сервер ---
# Ключ подписи состояния переговоров. Без него генерируется случайный на время
# работы процесса: после перезапуска незакрытые переговоры придётся начать
# заново. На деплое задать обязательно (любая длинная случайная строка).
SESSION_SECRET=
CORS_ORIGINS=*
XP_PER_LEVEL=100
