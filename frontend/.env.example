# Скопировать в .env и заполнить. Все значения публичные (попадают в браузер).

# Адрес бэкенда (FastAPI), без слэша в конце
VITE_API_URL=http://127.0.0.1:8000

# Supabase: Project Settings -> API. Нужен именно anon (public) ключ,
# НЕ service_role и НЕ SUPABASE_KEY из .env бэкенда.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
